# ~/.zsh/.zshrc  —  managed by cli-setup (macOS / Linux / WSL)
# https://github.com/NatLee/cli-setup
#
# Options chosen at install time live in ~/.zsh/options.zsh (re-run install.sh to change them).
# Personal tweaks go in ~/.zsh/.zshrc.local — it is never overwritten.

export ZSH=$HOME/.zsh
ZSH_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $ZSH_CACHE ]] || mkdir -p $ZSH_CACHE

typeset -U path fpath                       # no duplicate PATH entries
[[ -d $HOME/.local/bin ]] && path=($HOME/.local/bin $path)

# ---------- defaults (overridden by options.zsh) ----------
MZS_PLUGINS=(autosuggestions syntax-highlighting completions)
MZS_SUGGEST_COLOR=244
MZS_THEME=soft
MZS_CONDA=fast
[[ -r $ZSH/options.zsh ]] && source $ZSH/options.zsh

_mzs_has() { (( ${MZS_PLUGINS[(Ie)$1]} )); }

# Source the output of a slow init command, regenerated only when the binary changes.
#   _mzs_cached <name> <binary> <command...>
_mzs_cached() {
  local name=$1 bin=$2; shift 2
  local f=$ZSH_CACHE/$name.zsh
  if [[ ! -s $f || $bin -nt $f ]]; then
    "$@" >| $f 2>/dev/null || { rm -f $f; return 1; }
  fi
  source $f
}

# ================================
# History
# ================================
HISTFILE=$ZSH/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY        # save timestamps
setopt SHARE_HISTORY           # share history between open terminals
setopt HIST_IGNORE_ALL_DUPS    # drop older duplicates
setopt HIST_FIND_NO_DUPS       # no duplicates when searching
setopt HIST_IGNORE_SPACE       # " cmd" (leading space) is not saved
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY             # !! expands first, runs on next Enter

# ================================
# General
# ================================
setopt AUTO_CD                 # type a directory name to cd into it
setopt INTERACTIVE_COMMENTS    # allow # comments at the prompt
setopt NO_BEEP
export CLICOLOR=1
bindkey -e

# Keys most terminals send but zsh doesn't bind by default
#   Home / End (all common variants) · Delete · Ctrl/Option + ←/→ word jumps
() {
  local k
  for k in '^[[H' '^[OH' '^[[1~' '^[[7~';     do bindkey "$k" beginning-of-line; done
  for k in '^[[F' '^[OF' '^[[4~' '^[[8~';     do bindkey "$k" end-of-line;       done
  for k in '^[[1;5D' '^[[1;3D' '^[^[[D';     do bindkey "$k" backward-word;     done
  for k in '^[[1;5C' '^[[1;3C' '^[^[[C';     do bindkey "$k" forward-word;      done
  bindkey '^[[3~' delete-char
  bindkey '^[[3;5~' kill-word
}

# ================================
# Homebrew (cached `brew shellenv`)
# ================================
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $__brew ]] && { _mzs_cached brew-shellenv $__brew $__brew shellenv; break; }
done
unset __brew
[[ -n $HOMEBREW_PREFIX ]] && fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)

# ================================
# Completion (dump rebuilt at most once a day)
# ================================
_mzs_has completions && fpath=($ZSH/plugins/zsh-completions/src $fpath)
autoload -Uz compinit
__zcd=$ZSH_CACHE/zcompdump
__stale=($__zcd(N.mh+24))
if [[ ! -s $__zcd || -n $__stale ]]; then
  compinit -i -d $__zcd
  touch $__zcd
else
  compinit -C -d $__zcd
fi
{ [[ $__zcd.zwc -nt $__zcd ]] || zcompile $__zcd } &!
unset __zcd __stale

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path $ZSH_CACHE/zcompcache
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
if _mzs_has fzf-tab; then
  zstyle ':completion:*' menu no
  zstyle ':fzf-tab:*' fzf-flags --height=40% --color=bg+:236,hl:110,hl+:110,pointer:149,marker:176,prompt:110
  if [[ $OSTYPE == darwin* ]]; then
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 -G $realpath'
  else
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 --color=always $realpath'
  fi
else
  zstyle ':completion:*' menu select
fi

# ================================
# Plugins
# ================================
_mzs_has fzf-tab && (( $+commands[fzf] )) && source $ZSH/plugins/fzf-tab/fzf-tab.plugin.zsh

if _mzs_has you-should-use; then
  export YSU_MESSAGE_POSITION=after
  source $ZSH/plugins/zsh-you-should-use/you-should-use.plugin.zsh
fi

if _mzs_has syntax-highlighting; then
  FAST_WORK_DIR=$ZSH_CACHE/fsh
  # skip the plugin's one-time network download on first start
  [[ -e $FAST_WORK_DIR/secondary_theme.zsh ]] || { mkdir -p $FAST_WORK_DIR; touch $FAST_WORK_DIR/secondary_theme.zsh; }
  source $ZSH/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
  [[ $MZS_THEME != default && -r $ZSH/themes/$MZS_THEME.zsh ]] && source $ZSH/themes/$MZS_THEME.zsh
fi

if _mzs_has history-substring-search; then
  source $ZSH/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
  HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='fg=149,bold'
  HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=167,bold'
  HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey '^P'   history-substring-search-up
  bindkey '^N'   history-substring-search-down
fi

if _mzs_has autosuggestions; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=$MZS_SUGGEST_COLOR"
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
  ZSH_AUTOSUGGEST_USE_ASYNC=1
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1    # don't re-wrap widgets before every prompt
  source $ZSH/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# ================================
# CLI tools
# ================================
if _mzs_has fzf && (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border --color=bg+:236,hl:110,hl+:110,pointer:149,marker:176,prompt:110,info:244'
  # Ctrl-R history · Ctrl-T files · Alt-C cd   (fzf >= 0.48; older distro packages ship separate scripts)
  if ! _mzs_cached fzf $commands[fzf] fzf --zsh; then
    for __f in /usr/share/doc/fzf/examples/key-bindings.zsh /usr/share/fzf/key-bindings.zsh \
               /usr/share/fzf/shell/key-bindings.zsh; do
      [[ -r $__f ]] && { source $__f; break; }
    done
    unset __f
  fi
fi

_mzs_has aliases && [[ -r $ZSH/aliases.zsh ]] && source $ZSH/aliases.zsh

if _mzs_has eza && (( $+commands[eza] )); then
  alias ls='eza --icons=auto --group-directories-first'
  alias l='eza -l --icons=auto --group-directories-first --git --time-style=relative'
  alias ll='eza -la --icons=auto --group-directories-first --git --time-style=relative'
  alias la='eza -a --icons=auto --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto'
fi

# ================================
# Conda — Starship already shows the env, so hide conda's own "(base)" prefix.
#   fast : cached hook + instant base activation (default)
#   lazy : load conda on first `conda` call (fastest, base not active at start)
#   full : official `conda init` behaviour
#   off  : don't load conda
# ================================
export CONDA_CHANGEPS1=false
if [[ $MZS_CONDA != off ]]; then
  for __root in $HOME/miniconda3 $HOME/anaconda3 $HOME/miniforge3 $HOME/mambaforge \
                /opt/homebrew/Caskroom/miniconda/base /opt/homebrew/Caskroom/miniforge/base \
                /opt/conda /opt/miniconda3 /opt/anaconda3; do
    [[ -x $__root/bin/conda ]] || continue
    __root=${__root:A}    # resolve symlinks, as conda does
    case $MZS_CONDA in
      lazy)
        typeset -g __MZS_CONDA_ROOT=$__root
        conda() {
          unfunction conda
          eval "$($__MZS_CONDA_ROOT/bin/conda shell.zsh hook 2>/dev/null)"
          conda "$@"
        }
        ;;
      full)
        eval "$($__root/bin/conda shell.zsh hook 2>/dev/null)"
        ;;
      *)  # fast
        __hook=$ZSH_CACHE/conda-hook.zsh
        if [[ ! -s $__hook || $__root/bin/conda -nt $__hook ]]; then
          $__root/bin/conda shell.zsh hook 2>/dev/null | sed '/^conda activate/d' >| $__hook
        fi
        source $__hook
        # Activate base without spawning Python — unless base needs activation scripts / env vars.
        if [[ -z $CONDA_PREFIX ]]; then
          __adir=($__root/etc/conda/activate.d/*(N))
          if (( $#__adir )) || [[ -s $__root/conda-meta/state ]]; then
            conda activate base
          else
            export CONDA_SHLVL=1 CONDA_PREFIX=$__root CONDA_DEFAULT_ENV=base CONDA_PROMPT_MODIFIER=
            path=($__root/bin $path)
          fi
        fi
        unset __hook __adir
        ;;
    esac
    break
  done
  unset __root
fi

# ================================
# Prompt (Starship, cached init)
# ================================
export STARSHIP_CONFIG=~/.config/starship.toml
(( $+commands[starship] )) && _mzs_cached starship $commands[starship] starship init zsh --print-full-init

# zoxide must be initialised last
if _mzs_has zoxide && (( $+commands[zoxide] )); then
  _mzs_cached zoxide $commands[zoxide] zoxide init zsh    # z <dir> · zi = interactive
fi

# ================================
# Local overrides (not managed by this repo)
# ================================
[[ -f $ZSH/.zshrc.local ]] && source $ZSH/.zshrc.local

# Wrap every widget defined above for autosuggestions once (MANUAL_REBIND mode)
(( $+functions[_zsh_autosuggest_bind_widgets] )) && _zsh_autosuggest_bind_widgets

# Clear the cache after changing tools by hand:  zsh-cache-clear
zsh-cache-clear() { rm -rf $ZSH_CACHE/*.zsh $ZSH_CACHE/zcompdump* && echo "zsh cache cleared — restart the shell"; }
